[Unit]
Description=ADOS REST API
After=ados-mavlink.service
PartOf=ados-supervisor.service
StartLimitIntervalSec=0

[Service]
# Join the shared accounting slice so MemoryCurrent/CPUUsage are
# observable per unit (the slice sets MemoryAccounting=yes).
Slice=ados.slice
Type=simple
ExecStart=/opt/ados/venv/bin/python -m ados.services.api
Restart=always
RestartSec=3
Environment=ADOS_CONFIG=/etc/ados/config.yaml
EnvironmentFile=-/etc/ados/env

NoNewPrivileges=yes
ProtectSystem=strict
# The residual API writes only agent state: runtime config (config.yaml,
# peripherals, display.conf) under /etc/ados, sockets and sidecars under
# /run/ados, and data under /var/ados and /var/lib/ados. Plugin lifecycle is
# native and no longer runs here, so neither /etc nor /tmp is writable.
# The optional display install escapes this sandbox by design: it runs its
# package install through `systemd-run` as a transient unit outside the
# service's namespace.
ReadWritePaths=/etc/ados /run/ados /var/ados /var/lib/ados

MemoryMax=128M
CPUQuota=25%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ados-api

[Install]
WantedBy=ados-supervisor.service
