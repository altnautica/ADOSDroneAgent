[Unit]
Description=ADOS Cloud Relay (MQTT + Convex Heartbeat)
After=ados-mavlink.service
PartOf=ados-supervisor.service
# Skip cleanly when the binary was not fetched for this profile rather than
# crash-looping "binary missing"; the installer's health gate is the loud
# failure for a binary that SHOULD be present.
ConditionPathExists=/opt/ados/bin/ados-cloud
StartLimitIntervalSec=0

[Service]
# Join the shared accounting slice so MemoryCurrent/CPUUsage are
# observable per unit (the slice sets MemoryAccounting=yes).
Slice=ados.slice
Type=simple
# The native cloud relay is the only implementation. ConditionPathExists above
# keeps the unit inactive when the binary is absent. Cloud relay still defaults
# to local mode; this service is the secondary, opt-in remote path.
ExecStart=/opt/ados/bin/ados-cloud
Restart=always
RestartSec=3
Environment=ADOS_CONFIG=/etc/ados/config.yaml
EnvironmentFile=-/etc/ados/env

NoNewPrivileges=yes
ProtectSystem=strict
# A private /tmp keeps scratch files from a remote plugin install or a log
# export out of the shared /tmp, which ProtectSystem=strict would otherwise
# leave read-only.
PrivateTmp=yes
# /etc is writable because a remote plugin-install command unpacks the
# plugin and writes its per-plugin unit + the shared slice under
# /etc/systemd/system. The radio bind keygen no longer runs here (it moved
# to the supervisor); runtime config writes land under /etc/ados. A remote
# uninstall deletes the plugin's logs under /var/log/ados/plugins.
ReadWritePaths=/var/ados /var/lib/ados /run/ados /etc/ados /etc /var/log/ados

# The cloud relay does HTTP + MQTT heartbeat and, on a remote-install
# command, asks PID 1 to reload/enable units over the system bus (which
# needs no caller capability). The one capability it keeps is CAP_CHOWN: a
# remote install or enable hands the plugin's data dir under
# /var/ados/plugin-data (and an HTTP-serving plugin's socket dir under
# /run/ados/plugin-http) to the ados account its sandboxed unit runs as, and
# root without CAP_CHOWN cannot.
CapabilityBoundingSet=CAP_CHOWN

# The heartbeat, MQTT and log-push loops are small. The cap is set by a remote
# plugin install, which holds the archive (at most 50 MiB) and its decompressed
# entries (at most 100 MiB) in memory while it verifies them, plus a log-push
# window of up to 32 MiB.
MemoryMax=256M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ados-cloud

[Install]
WantedBy=ados-supervisor.service
