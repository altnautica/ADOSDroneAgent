[Unit]
Description=ADOS Native Control API
# The control surface projects the live vehicle state + FC command path, so it
# orders after the MAVLink service that owns both sockets. The logging store
# (health source) is best-effort: an absent store degrades health, never blocks.
After=ados-mavlink.service
PartOf=ados-supervisor.service
StartLimitIntervalSec=0
# A box whose binary has not landed yet stays inactive rather than looping.
ConditionPathExists=/opt/ados/bin/ados-control

[Service]
# Join the shared accounting slice so MemoryCurrent/CPUUsage are observable.
Slice=ados.slice
# The native control surface is the LAN front on every node. Its installer
# drop-in sets ADOS_CONTROL_PORT=8080, so this unit owns :8080 while the
# residual Python API sits behind it on an internal socket; it also binds
# /run/ados/control.sock. Restart forever on any exit: a node without its front
# is unreachable on the LAN.
Type=simple
ExecStart=/opt/ados/bin/ados-control
Restart=always
RestartSec=3
Environment=RUST_LOG=info
EnvironmentFile=-/etc/ados/env

# The control surface reads the vehicle-state + MAVLink + logging sockets and the
# install-result + board sidecars, writes the pairing document and its own control
# socket, and on a ground station creates + writes session recordings under
# /var/ados/recordings. /var/ados (mutable agent data) and /var/lib/ados (the
# install-result read) are both listed so writes resolve under ProtectSystem=strict
# exactly as the sibling daemons do. /etc/systemd/network is where the MAC-pin
# unpin route deletes its next-boot .link; it carries the '-' prefix because a
# host without systemd-networkd may not have the directory.
#
# It also serves the plugin lifecycle (/api/plugins): an install unpacks under
# /var/ados/plugins and writes the plugin's units plus the shared slice under
# /etc/systemd/system, and a remove deletes the plugin's logs under
# /var/log/ados/plugins.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/ados /etc/ados /run/ados /var/lib/ados /var/log/ados /etc/systemd/system -/etc/systemd/network

# No Python runtime and no plugin code runs in-process, but a plugin install
# holds the archive (at most 50 MiB) and its decompressed entries (at most
# 100 MiB) in memory while it verifies them; the cap leaves room for that
# on top of the serving footprint so an install is never OOM-killed mid-swap.
MemoryMax=384M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ados-control

[Install]
# The installer enables it on every install. Wanted by the supervisor (which
# it is PartOf) so a supervisor restart cycles it with the set.
WantedBy=ados-supervisor.service
