[Unit]
Description=ADOS Native Control API
# The control surface projects the live vehicle state + FC command path, so it
# orders after the MAVLink service that owns both sockets. The logging store
# (health source) is best-effort: an absent store degrades health, never blocks.
After=ados-mavlink.service
PartOf=ados-supervisor.service
StartLimitIntervalSec=0

[Service]
# Join the shared accounting slice so MemoryCurrent/CPUUsage are observable.
Slice=ados.slice
# The native control surface is the LAN front: every install writes the
# `front-rust-enabled` marker, and its drop-in sets ADOS_CONTROL_PORT=8080 so
# this unit owns :8080 while the residual Python API sits behind it on an
# internal socket. Removing that marker (`ados rust disable front`, for a debug
# session) hands :8080 back to Python until the next install restores it. The
# `control-rust-enabled` marker alone runs the surface on the alternate LAN port
# (default :8082) beside Python. Both bind /run/ados/control.sock. With neither
# marker, or no binary, the unit execs /bin/true and exits clean. Type=simple
# (not notify) because the /bin/true branch never signals readiness; this
# matches the other guarded units.
Type=simple
ExecStart=/bin/sh -c 'if { [ -e /etc/ados/control-rust-enabled ] || [ -e /etc/ados/front-rust-enabled ]; } && [ -x /opt/ados/bin/ados-control ]; then exec /opt/ados/bin/ados-control; else exec /bin/true; fi'
Restart=always
# Exit 0 means this node has nothing for the unit to run (feature off, role
# not applicable, display absent); it must not respawn every RestartSec. Any
# other exit, signal or watchdog timeout restarts forever (no start limit).
RestartPreventExitStatus=0
RestartSec=3
Environment=RUST_LOG=info
EnvironmentFile=-/etc/ados/env

# The control surface reads the vehicle-state + MAVLink + logging sockets and the
# install-result + board sidecars, writes the pairing document and its own control
# socket, and on a ground station creates + writes session recordings under
# /var/ados/recordings. /var/ados (mutable agent data) and /var/lib/ados (the
# install-result read) are both listed so writes resolve under ProtectSystem=strict
# exactly as the sibling daemons do. /etc/systemd/network is where the MAC-pin
# unpin route deletes its next-boot .link; it carries the '-' prefix because a
# host without systemd-networkd may not have the directory.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/ados /etc/ados /run/ados /var/lib/ados -/etc/systemd/network

# The surface is lightweight (no Python runtime, no plugin load); cap it so a
# runaway can never starve the box.
MemoryMax=128M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ados-control

[Install]
# The installer enables it whenever a marker is present, which is every install
# (the front marker is written by default). Wanted by the supervisor (which it
# is PartOf) so a supervisor restart cycles it with the set.
WantedBy=ados-supervisor.service
