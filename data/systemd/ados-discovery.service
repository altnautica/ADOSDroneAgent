[Unit]
Description=ADOS mDNS Discovery
# Not ordered after network-online.target: this unit serves on-box sockets and
# wildcard binds that need no configured network, and waiting on it held the
# FC link (and every unit ordered after this one) until wait-online timed out
# whenever a remembered Wi-Fi was out of range at boot.
PartOf=ados-supervisor.service
StartLimitIntervalSec=0

[Service]
# Join the shared accounting slice so MemoryCurrent/CPUUsage are
# observable per unit (the slice sets MemoryAccounting=yes).
Slice=ados.slice
Type=simple
ExecStart=/opt/ados/venv/bin/python -m ados.services.discovery
Restart=always
RestartSec=3
Environment=ADOS_CONFIG=/etc/ados/config.yaml
EnvironmentFile=-/etc/ados/env

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/ados /run/ados /etc/ados

MemoryMax=20M
CPUQuota=5%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ados-discovery

[Install]
WantedBy=ados-supervisor.service
