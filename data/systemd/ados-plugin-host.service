[Unit]
Description=ADOS Plugin Host
After=ados-mavlink.service
PartOf=ados-supervisor.service
StartLimitInterval=60s
StartLimitBurst=5

[Service]
# Join the shared accounting slice so MemoryCurrent/CPUUsage are
# observable per unit (the slice sets MemoryAccounting=yes).
Slice=ados.slice
Type=simple
# The native plugin host owns the per-plugin sockets. There is no longer a
# packaged host server to fall back to, so the ExecStart is the binary itself
# rather than a shell that chose between them. A routine install enables this
# unit and the supervisor pulls it up (see [Install] below) with zero manual
# steps. ConditionPathExists keeps a box whose binary has not landed yet
# inactive rather than restart-looping.
ConditionPathExists=/opt/ados/bin/ados-plugin-host
ExecStart=/opt/ados/bin/ados-plugin-host
Restart=on-failure
RestartSec=3
Environment=ADOS_CONFIG=/etc/ados/config.yaml
EnvironmentFile=-/etc/ados/env

NoNewPrivileges=yes
ProtectSystem=strict
# The shipping daemon only discovers plugins + serves sockets (read-only), so
# the current grants suffice and plugin lifecycle writes stay on the privileged
# install path. When install/enable/remove move into this daemon, it will write
# per-plugin unit files + the shared slice under /etc/systemd/system, append
# logs under /var/log/ados/plugins, and unpack under /var/ados/plugins — add
# those to ReadWritePaths at that cutover.
ReadWritePaths=/var/ados /run/ados /etc/ados
LimitNOFILE=8192

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ados-plugin-host

[Install]
# The native host owns the per-plugin sockets, so a routine install enables this
# unit. Wanted by the supervisor (which it is PartOf) so the supervisor pulls it
# up and a supervisor restart cycles it with the rest of the set.
WantedBy=ados-supervisor.service
