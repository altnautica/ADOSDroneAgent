[Unit]
Description=ADOS Power Hardening Re-assert
# Not ordered after network-online.target: pulling that target in stalled the
# MAVLink unit's start on every boot where a remembered Wi-Fi was out of range.
# The reassert script waits (bounded) for a default route itself before the
# Ethernet EEE step, the one step that needs to know the management NIC.

[Service]
Type=oneshot
ExecStart=/opt/ados/bin/ados-power-reassert.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
