[Unit]
Description=ADOS Captive Portal DNS + HTTP responder (first-boot only)
After=ados-hostapd.service
PartOf=ados-supervisor.service
# Only run while setup is incomplete. Once the sentinel exists the unit
# is skipped (shown inactive, condition unmet) instead of reporting a
# spurious failed state on every already-configured boot.
ConditionPathExists=!/var/lib/ados/setup-complete
StartLimitIntervalSec=0

[Service]
# Join the shared accounting slice so MemoryCurrent/CPUUsage are
# observable per unit (the slice sets MemoryAccounting=yes).
Slice=ados.slice
Type=simple
User=root
ExecStart=/opt/ados/venv/bin/python -m ados.services.setup_webapp.captive_dns
Restart=always
# 0 is the "nothing to serve" exit: setup is complete, ados-dnsmasq-gs owns
# DNS, or port 53 is already taken. Restarting it started Python every
# RestartSec= until setup completed. A crash still restarts.
RestartPreventExitStatus=0
RestartSec=3
Environment=ADOS_CONFIG=/etc/ados/config.yaml
EnvironmentFile=-/etc/ados/env

AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=no

MemoryMax=48M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ados-setup-captive

[Install]
WantedBy=ados-supervisor.service
