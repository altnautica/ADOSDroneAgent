[Unit]
Description=ADOS WFB-ng receiver (mesh receiver role)
After=ados-batman.service
Wants=ados-batman.service
PartOf=ados-supervisor.service
# Runs only while the role sentinel reads `receiver`: under any other role the
# binary reports ready and exits 0, which is never restarted. The supervisor
# writes the sentinel and starts this unit on a transition into the role.
ConditionPathExists=/etc/ados/mesh/role
StartLimitIntervalSec=0

[Service]
# Join the shared accounting slice so MemoryCurrent/CPUUsage are
# observable per unit (the slice sets MemoryAccounting=yes).
Slice=ados.slice
# Type=notify + WatchdogSec so systemd can recover a WEDGED role loop, not just
# a crashed one. The keep-alive ping is coupled to the loop's progress marker
# (the periodic state write), so a process that still exists while its work has
# stopped is no longer reported as healthy. Kept in lock-step with
# ados_supervisor::sdnotify::WATCHDOG_SEC, which sets the ping cadence.
Type=notify
WatchdogSec=30
User=root
# The native receiver loop is the only implementation; the install verifies the
# binary is present before this unit starts. The binary takes the role on its
# `--role` argument.
ExecStart=/opt/ados/bin/ados-groundlink --role receiver
Restart=always
RestartPreventExitStatus=0
RestartSec=3
Environment=ADOS_CONFIG=/etc/ados/config.yaml
EnvironmentFile=-/etc/ados/env

# Receiver drives wfb_rx -a which binds a raw socket on the local NIC
# plus a UDP listener on the mesh interface.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=no
ProtectSystem=strict
ReadWritePaths=/var/ados /run/ados /dev /etc/ados

MemoryMax=96M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ados-wfb-receiver

[Install]
WantedBy=ados-supervisor.service
