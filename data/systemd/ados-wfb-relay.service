[Unit]
Description=ADOS WFB-ng relay (mesh relay role)
After=ados-batman.service
Wants=ados-batman.service
PartOf=ados-supervisor.service
# Runs only while the role sentinel reads `relay`: under any other role the
# binary reports ready and exits 0, which is never restarted. The supervisor
# writes the sentinel and starts this unit on a transition into the role.
ConditionPathExists=/etc/ados/mesh/role
StartLimitIntervalSec=0

[Service]
# Join the shared accounting slice so MemoryCurrent/CPUUsage are
# observable per unit (the slice sets MemoryAccounting=yes).
Slice=ados.slice
# Type=notify + WatchdogSec so systemd can recover a WEDGED role loop, not just
# a crashed one. The keep-alive ping is coupled to the loop's progress marker
# (one stamp per mDNS-resolve/forwarder-reconcile pass), so a process that still
# exists while its work has stopped is no longer reported as healthy. Kept in
# lock-step with ados_supervisor::sdnotify::WATCHDOG_SEC, the ping cadence.
Type=notify
WatchdogSec=30
User=root
# The native relay loop is the only implementation; the install verifies the
# binary is present before this unit starts. The binary takes the role on its
# `--role` argument.
ExecStart=/opt/ados/bin/ados-groundlink --role relay
Restart=always
RestartPreventExitStatus=0
RestartSec=3
Environment=ADOS_CONFIG=/etc/ados/config.yaml
EnvironmentFile=-/etc/ados/env

# Relay shells out to wfb_rx -f which needs raw socket + monitor mode.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=no
ProtectSystem=strict
ReadWritePaths=/var/ados /run/ados /dev /etc/ados

MemoryMax=64M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ados-wfb-relay

[Install]
WantedBy=ados-supervisor.service
