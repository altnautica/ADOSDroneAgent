    {
      "arguments": [],
      "help": "Export a window of the store to the paired cloud account.\n\n    This is a thin front door: it records the request and lets the cloud service\n    do the export, upload, and mark. The cloud service refuses the push when the\n    agent is in local mode, is not cloud-paired, or has cloud log push disabled,\n    which is the correct state for an agent that has nothing to sync. By default\n    the command waits a few seconds for the result and prints what was pushed;\n    ``--no-wait`` returns as soon as the request is recorded.\n\n    The request file lives under the root-owned runtime dir: root records it\n    directly, while a non-root operator hands the write to the running agent on\n    loopback and only falls back to the direct seam if the agent is unreachable.",
      "options": [
        {
          "default": null,
          "flags": [
            "--session"
          ],
          "help": "Restrict the window to one session id.",
          "required": false,
          "type": "integer"
        },
        {
          "default": null,
          "flags": [
            "--since"
          ],
          "help": "Lower bound: a relative -5m/-2h/-1d, an epoch-us integer, or an ISO timestamp.",
          "required": false,
          "type": "text"
        },
        {
          "default": null,
          "flags": [
            "--kinds"
          ],
          "help": "Comma-separated subset of logs,metrics,events,hw. Default: all four.",
          "required": false,
          "type": "text"
        },
        {
          "default": "Sentinel.UNSET",
          "flags": [
            "--no-wait"
          ],
          "help": "Return as soon as the push is requested, without waiting for the result.",
          "required": false,
          "type": "boolean"
        },
        {
          "default": "Sentinel.UNSET",
          "flags": [
            "--json"
          ],
          "help": "Print the raw result envelope.",
          "required": false,
          "type": "boolean"
        }
      ],
      "path": "logs push"
    },
