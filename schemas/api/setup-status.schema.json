    "setup_complete": {
      "title": "Setup Complete",
      "type": "boolean"
    },
    "setup_finalized": {
      "default": false,
      "title": "Setup Finalized",
      "type": "boolean"
    },
    "setup_skipped": {
      "default": false,
      "title": "Setup Skipped",
      "type": "boolean"
    },
    "setup_state": {
      "default": "auto",
      "enum": [
        "auto",
        "needs_review",
        "configured"
      ],
      "title": "Setup State",
      "type": "string"
    },
    "skipped_steps": {
      "items": {
        "type": "string"
      },
      "title": "Skipped Steps",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/SetupStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "video": {
      "$ref": "#/$defs/VideoAccess"
    }
  },
  "required": [
    "access_urls",
    "cloud_choice",
    "completion_percent",
    "device_id",
    "device_name",
    "ground_role",
    "hardware_check",
    "lan_host",
    "mavlink",
    "network",
    "next_action",
    "paired",
    "pairing_code",
    "profile",
    "profile_source",
    "profile_suggestion",
    "remote_access",
    "setup_complete",
    "setup_finalized",
    "setup_skipped",
    "setup_state",
    "skipped_steps",
    "steps",
    "version",
    "video"
  ],
  "title": "SetupStatus",
  "type": "object"
}
