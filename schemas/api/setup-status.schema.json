    },
    "device_name": {
      "title": "Device Name",
      "type": "string"
    },
    "ground_role": {
      "default": "",
      "title": "Ground Role",
      "type": "string"
    },
    "hardware_check": {
      "anyOf": [
        {
          "$ref": "#/$defs/HardwareCheckStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lan_host": {
      "default": "",
      "title": "Lan Host",
      "type": "string"
    },
    "mavlink": {
      "$ref": "#/$defs/MavlinkAccess"
    },
    "network": {
      "$ref": "#/$defs/NetworkStatus"
    },
    "next_action": {
      "title": "Next Action",
      "type": "string"
    },
    "paired": {
      "default": false,
      "title": "Paired",
      "type": "boolean"
    },
    "pairing_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pairing Code"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "profile_source": {
      "default": "detected",
      "enum": [
        "detected",
        "tiebreaker",
        "override",
        "default",
        "user"
      ],
      "title": "Profile Source",
      "type": "string"
    },
    "profile_suggestion": {
      "$ref": "#/$defs/ProfileSuggestion"
    },
    "remote_access": {
      "$ref": "#/$defs/RemoteAccessStatus"
