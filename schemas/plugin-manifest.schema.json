{
  "$defs": {
    "AgentBlock": {
      "additionalProperties": false,
      "description": "Agent-half manifest block.",
      "properties": {
        "binaries": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Binaries",
          "type": "object"
        },
        "contains_vendor_binary": {
          "default": false,
          "title": "Contains Vendor Binary",
          "type": "boolean"
        },
        "contributes": {
          "$ref": "#/$defs/AgentContributes"
        },
        "declared_capabilities": {
          "items": {
            "$ref": "#/$defs/DeclaredCapability"
          },
          "title": "Declared Capabilities",
          "type": "array"
        },
        "entrypoint": {
          "title": "Entrypoint",
          "type": "string"
        },
        "http": {
          "default": false,
          "title": "Http",
          "type": "boolean"
        },
        "isolation": {
          "default": "subprocess",
          "enum": [
            "subprocess",
            "inprocess"
          ],
          "title": "Isolation",
          "type": "string"
        },
        "mavlink_components": {
          "items": {
            "$ref": "#/$defs/MavlinkComponent"
          },
          "title": "Mavlink Components",
          "type": "array"
        },
        "payloads": {
          "items": {
            "$ref": "#/$defs/PayloadSpec"
          },
          "title": "Payloads",
          "type": "array"
        },
        "per_drone_config": {
          "default": false,
          "title": "Per Drone Config",
          "type": "boolean"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/PermissionRef"
          },
          "title": "Permissions",
          "type": "array"
        },
        "resources": {
          "$ref": "#/$defs/ResourceLimits"
        },
        "runtime": {
          "default": "python",
          "enum": [
            "python",
            "rust"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "subprocess_spawn": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subprocess Spawn"
        },
        "target_profiles": {
          "items": {
            "enum": [
              "drone",
              "ground-station",
              "workstation",
              "compute"
            ],
            "type": "string"
          },
          "title": "Target Profiles",
          "type": "array"
        },
        "test_fixtures": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Test Fixtures",
          "type": "object"
        },
        "vendor_attribution": {
          "items": {
            "$ref": "#/$defs/VendorAttribution"
          },
          "title": "Vendor Attribution",
          "type": "array"
        }
      },
      "required": [
        "entrypoint"
      ],
      "title": "AgentBlock",
      "type": "object"
    },
    "AgentContributes": {
      "additionalProperties": false,
      "properties": {
        "drivers": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Drivers",
          "type": "array"
        },
        "prompts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Prompts",
          "type": "array"
        },
        "resources": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Resources",
          "type": "array"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceSpec"
          },
          "title": "Services",
          "type": "array"
        },
        "shared_topics": {
          "items": {
            "$ref": "#/$defs/SharedTopic"
          },
          "title": "Shared Topics",
          "type": "array"
        },
        "tools": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tools",
          "type": "array"
        },
        "vision": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisionContribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AgentContributes",
      "type": "object"
    },
    "AgentPage": {
      "additionalProperties": false,
      "description": "A full page the plugin adds to a node's navigation in the GCS.\n\n``section`` / ``after`` / ``order`` place it in the menu; ``profile``\nnarrows the node profiles it appears on (``None`` = every profile).\n``setup_for`` marks this page as the setup flow of another page in the\nsame list.",
      "properties": {
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "profile": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "drone",
                  "ground-station",
                  "workstation",
                  "compute"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "setup_for": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup For"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "AgentPage",
      "type": "object"
    },
    "Compatibility": {
      "additionalProperties": false,
      "properties": {
        "ados_version": {
          "minLength": 1,
          "title": "Ados Version",
          "type": "string"
        },
        "gcs_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gcs Version"
        },
        "min_tier": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Tier"
        },
        "supported_boards": {
          "items": {
            "type": "string"
          },
          "title": "Supported Boards",
          "type": "array"
        }
      },
      "required": [
        "ados_version"
      ],
      "title": "Compatibility",
      "type": "object"
    },
    "DeclaredCapability": {
      "additionalProperties": false,
      "description": "A capability the plugin defines for other plugins to request, e.g. to\nsubscribe to one of its shared topics. The id is namespaced to the\nplugin: ``plugin.<leaf>.<name>`` (checked on :class:`PluginManifest`,\nwhich knows the plugin id).",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "id",
        "risk"
      ],
      "title": "DeclaredCapability",
      "type": "object"
    },
    "FcParameter": {
      "additionalProperties": false,
      "description": "A single firmware parameter the plugin expects the operator to\nset before the feature behaves correctly. ``value`` is optional\nbecause some parameters take a bitmask the operator computes from\nmultiple flags; in that case ``note`` carries the guidance.",
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "param": {
          "minLength": 1,
          "title": "Param",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "param"
      ],
      "title": "FcParameter",
      "type": "object"
    },
    "GcsBlock": {
      "additionalProperties": false,
      "description": "GCS-half manifest block.",
      "properties": {
        "contributes": {
          "$ref": "#/$defs/GcsContributes"
        },
        "entrypoint": {
          "title": "Entrypoint",
          "type": "string"
        },
        "isolation": {
          "default": "iframe",
          "enum": [
            "iframe",
            "inline"
          ],
          "title": "Isolation",
          "type": "string"
        },
        "locales": {
          "items": {
            "type": "string"
          },
          "title": "Locales",
          "type": "array"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/PermissionRef"
          },
          "title": "Permissions",
          "type": "array"
        }
      },
      "required": [
        "entrypoint"
      ],
      "title": "GcsBlock",
      "type": "object"
    },
    "GcsContributes": {
      "additionalProperties": false,
      "properties": {
        "agent_pages": {
          "items": {
            "$ref": "#/$defs/AgentPage"
          },
          "title": "Agent Pages",
          "type": "array"
        },
        "models": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Models",
          "type": "array"
        },
        "node_surfaces": {
          "items": {
            "$ref": "#/$defs/NodeSurface"
          },
          "title": "Node Surfaces",
          "type": "array"
        },
        "notifications": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Notifications",
          "type": "array"
        },
        "overlays": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Overlays",
          "type": "array"
        },
        "panels": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Panels",
          "type": "array"
        },
        "parameters": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Parameters",
          "type": "array"
        },
        "prompts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Prompts",
          "type": "array"
        },
        "resources": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Resources",
          "type": "array"
        },
        "settings": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Settings",
          "type": "array"
        },
        "skills": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Skills",
          "type": "array"
        },
        "smart_functions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Smart Functions",
          "type": "array"
        },
        "tabs": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tabs",
          "type": "array"
        },
        "target_actions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Target Actions",
          "type": "array"
        },
        "tools": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "title": "GcsContributes",
      "type": "object"
    },
    "HardwareRequirements": {
      "additionalProperties": false,
      "description": "Optional hardware-side requirements surfaced in the install dialog.\n\nAll fields are free-form so the dialog can render whatever the\nmanifest author wants the operator to see. The agent does not enforce\nany of these at install time; they are informational copy.",
      "properties": {
        "boards": {
          "items": {
            "type": "string"
          },
          "title": "Boards",
          "type": "array"
        },
        "cameras": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cameras"
        },
        "fc_firmware": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fc Firmware"
        },
        "optional": {
          "items": {
            "type": "string"
          },
          "title": "Optional",
          "type": "array"
        }
      },
      "title": "HardwareRequirements",
      "type": "object"
    },
    "MavlinkComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "maximum": 255,
          "minimum": 0,
          "title": "Component Id",
          "type": "integer"
        },
        "component_kind": {
          "enum": [
            "camera",
            "gimbal",
            "payload",
            "peripheral",
            "generic",
            "vio"
          ],
          "title": "Component Kind",
          "type": "string"
        },
        "sub_id": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sub Id"
        }
      },
      "required": [
        "component_id",
        "component_kind"
      ],
      "title": "MavlinkComponent",
      "type": "object"
    },
    "NodeSurface": {
      "additionalProperties": false,
      "description": "A card the plugin adds to a node's overview in the GCS, shown on the\nlisted node profiles, optionally under one of the fixed groups.",
      "properties": {
        "group": {
          "anyOf": [
            {
              "enum": [
                "status",
                "vehicle",
                "link",
                "device",
                "compute"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "profile": {
          "items": {
            "enum": [
              "drone",
              "ground-station",
              "workstation",
              "compute"
            ],
            "type": "string"
          },
          "title": "Profile",
          "type": "array"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "profile"
      ],
      "title": "NodeSurface",
      "type": "object"
    },
    "PayloadSpec": {
      "additionalProperties": false,
      "description": "A large file fetched at install time instead of shipped in the archive\n(model weights, maps). The installer downloads ``source``, checks the\nsize and SHA-256, and places it at ``path`` under the plugin directory.\n``profiles`` / ``arch_os`` narrow which nodes fetch it; ``None`` means\nevery node the plugin installs on.",
      "properties": {
        "arch_os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arch Os"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "profiles": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "drone",
                  "ground-station",
                  "workstation",
                  "compute"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profiles"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "path",
        "source",
        "sha256",
        "size_bytes"
      ],
      "title": "PayloadSpec",
      "type": "object"
    },
    "PermissionRef": {
      "additionalProperties": false,
      "description": "Object form of a permission entry: ``{id, required, degraded_behavior}``.",
      "properties": {
        "degraded_behavior": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degraded Behavior"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "PermissionRef",
      "type": "object"
    },
    "RequiredFcParameters": {
      "additionalProperties": false,
      "description": "Per-firmware bucket of required parameter hints. Each bucket is\noptional so a plugin can ship guidance for only the firmware it\nactually targets.",
      "properties": {
        "ardupilot": {
          "items": {
            "$ref": "#/$defs/FcParameter"
          },
          "title": "Ardupilot",
          "type": "array"
        },
        "inav": {
          "items": {
            "$ref": "#/$defs/FcParameter"
          },
          "title": "Inav",
          "type": "array"
        },
        "px4": {
          "items": {
            "$ref": "#/$defs/FcParameter"
          },
          "title": "Px4",
          "type": "array"
        }
      },
      "title": "RequiredFcParameters",
      "type": "object"
    },
    "ResourceImpact": {
      "additionalProperties": false,
      "description": "Estimated runtime resource impact. The supervisor still enforces\nthe hard limits declared under ``agent.resources``; these numbers are\nforecast copy for the install-dialog summary.",
      "properties": {
        "cpu_percent_peak": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Percent Peak"
        },
        "output_rate_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Rate Hz"
        },
        "pids": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids"
        },
        "ram_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ram Mb"
        },
        "startup_time_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Startup Time Seconds"
        }
      },
      "title": "ResourceImpact",
      "type": "object"
    },
    "ResourceLimits": {
      "additionalProperties": false,
      "description": "Hard resource envelope for the plugin's processes.\n\n``class`` picks the ceiling set: ``standard`` caps each field at\n:data:`STANDARD_RESOURCE_CEILINGS`; ``heavy`` lifts the caps to the field\nbounds below for plugins that run large models or simulations.",
      "properties": {
        "class": {
          "default": "standard",
          "enum": [
            "standard",
            "heavy"
          ],
          "title": "Class",
          "type": "string"
        },
        "max_cpu_percent": {
          "default": 25,
          "maximum": 3200,
          "minimum": 1,
          "title": "Max Cpu Percent",
          "type": "integer"
        },
        "max_pids": {
          "default": 12,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Pids",
          "type": "integer"
        },
        "max_ram_mb": {
          "default": 96,
          "maximum": 65536,
          "minimum": 8,
          "title": "Max Ram Mb",
          "type": "integer"
        }
      },
      "title": "ResourceLimits",
      "type": "object"
    },
    "Screenshot": {
      "additionalProperties": false,
      "description": "One screenshot entry rendered by the install dialog.",
      "properties": {
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "Screenshot",
      "type": "object"
    },
    "ServiceSpec": {
      "additionalProperties": false,
      "description": "A long-running service a plugin declares on top of its main half.\n\nThe supervisor renders one extra systemd unit per spec under the\nplugin slice and starts/stops it across the plugin's enable/disable\nlifecycle. Each spec reports readiness on the heartbeat so the GCS\ncan show whether the declared daemon is actually up and serving.\n\nFields:\n\n* ``name`` \u2014 short identifier, unique within the plugin. Used to\n  build the unit name (``ados-plugin-<id>-<name>.service``, with\n  dots and underscores sanitized to hyphens) and to key the\n  readiness entry. Lowercase alnum plus ``.``, ``_``, ``-``.\n* ``command`` \u2014 the exec line the unit runs, as an argv (POSIX quoting,\n  never a shell). The renderer re-quotes each word for systemd and\n  refuses control characters and systemd exec prefixes; the plugin\n  author is responsible for an absolute path or a binary on ``PATH``.\n  A first word of ``bin:<name>`` runs the packaged binary ``<name>``\n  from ``agent.binaries``.\n* ``ready_check`` \u2014 how readiness is probed. ``None`` \u21d2 the service\n  is ready iff its unit is active. An ``http(s)://127.0.0.1:<port>``\n  URL \u21d2 an HTTP GET, ready on a 2xx status. Any other value \u21d2 an\n  argv (POSIX quoting, never a shell) run as the plugin user inside\n  the plugin's sandbox, ready on exit code 0.\n* ``restart`` \u2014 systemd restart policy for the unit.\n* ``profiles`` \u2014 node profiles the service runs on. ``None`` \u21d2 every\n  profile the plugin targets; an empty list is refused.\n* ``listen_ports`` \u2014 TCP/UDP ports the service binds (1024-65535, at\n  most four, unique). Declaring any requires the ``network.listen`` and\n  ``network.outbound`` capabilities.\n* ``slice`` \u2014 cgroup slice the unit runs in. Always the shared plugin\n  slice; any other value is refused, so a plugin cannot move its own\n  service out of the plugin resource envelope.\n\nBackward-compatible: a bare string element in ``services`` is\ncoerced to ``{\"name\": <s>, \"command\": <s>}`` so existing\n``services: [\"foo\"]`` manifests still parse.",
      "properties": {
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "listen_ports": {
          "items": {
            "maximum": 65535,
            "minimum": 1024,
            "type": "integer"
          },
          "maxItems": 4,
          "title": "Listen Ports",
          "type": "array"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "profiles": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "drone",
                  "ground-station",
                  "workstation",
                  "compute"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profiles"
        },
        "ready_check": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ready Check"
        },
        "restart": {
          "default": "on-failure",
          "enum": [
            "always",
            "on-failure",
            "no"
          ],
          "title": "Restart",
          "type": "string"
        },
        "slice": {
          "default": "ados-plugins.slice",
          "title": "Slice",
          "type": "string"
        }
      },
      "required": [
        "name",
        "command"
      ],
      "title": "ServiceSpec",
      "type": "object"
    },
    "SharedTopic": {
      "additionalProperties": false,
      "description": "A topic the plugin publishes for other plugins to subscribe to.\n\n``topic`` lives in the plugin's own namespace (``plugin.<leaf>.<rest>``);\na subscriber needs ``subscribe_capability``, which is either a catalog\ncapability or one of this plugin's ``declared_capabilities``.",
      "properties": {
        "subscribe_capability": {
          "minLength": 1,
          "title": "Subscribe Capability",
          "type": "string"
        },
        "topic": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "subscribe_capability"
      ],
      "title": "SharedTopic",
      "type": "object"
    },
    "VendorAttribution": {
      "additionalProperties": true,
      "description": "Source-offer record for plugins that ship a vendor binary.\n\nRequired when ``agent.contains_vendor_binary`` is true so the install\ndialog can surface the upstream repo, version, license, and a\nreachable source URL. Satisfies GPL-3.0 section 6 for plugins that\ndistribute pre-compiled binaries built from GPL-compatible\nupstreams.\n\nAccepts two equivalent field name sets so existing first-party\nplugins do not have to migrate their manifest copy:\n\n* ``name`` / ``source_url`` / ``upstream_version`` (informational)\n* ``upstream_repo`` / ``source_offer_url`` / ``commit_sha`` (legalistic)\n\nOnly ``license`` is strictly required; the other fields are\noptional and at least one of ``source_url`` or ``source_offer_url``\nplus one of ``upstream_version`` or ``commit_sha`` should be set\nfor the GCS install dialog to render meaningful disclosure.",
      "properties": {
        "commit_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "notice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notice"
        },
        "source_offer_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Offer Url"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "upstream_repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Repo"
        },
        "upstream_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Version"
        }
      },
      "required": [
        "license"
      ],
      "title": "VendorAttribution",
      "type": "object"
    },
    "VisionContribution": {
      "additionalProperties": false,
      "properties": {
        "behaviors": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Behaviors",
          "type": "array"
        },
        "detectors": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Detectors",
          "type": "array"
        },
        "models": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Models",
          "type": "array"
        }
      },
      "title": "VisionContribution",
      "type": "object"
    }
  },
